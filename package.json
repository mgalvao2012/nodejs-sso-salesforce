{
  "name": "node-crud-sso",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "NODE_ENV=development node --watch --env-file-if-exists=.env src/server.js",
    "start": "node src/server.js",
    "test": "vitest run",
    "migrate": "node --env-file-if-exists=.env node_modules/node-pg-migrate/bin/node-pg-migrate.js up -j js --database-url-var DATABASE_MIGRATION_URL",
    "test:migrate": "DATABASE_MIGRATION_URL=postgres://app_migrator:migrator@localhost:55433/app_test node node_modules/node-pg-migrate/bin/node-pg-migrate.js up -j js --database-url-var DATABASE_MIGRATION_URL",
    "lint": "eslint src && node scripts/check-views.js",
    "create-admin": "node --env-file-if-exists=.env src/cli/create-admin.js",
    "dev:tunnel": "bash scripts/dev-tunnel.sh",
    "init-env": "bash scripts/init-env.sh",
    "rotate-credentials": "bash scripts/rotate-eca-credentials.sh",
    "set-app-url": "bash scripts/set-app-url.sh"
  },
  "dependencies": {
    "argon2": "^0.45.1",
    "connect-pg-simple": "^10.0.0",
    "cookie-signature": "^1.2.2",
    "csrf-sync": "^4.2.1",
    "ejs": "^7.0.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "method-override": "^3.0.0",
    "node-pg-migrate": "^9.0.0",
    "pg": "^8.23.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.13.0",
    "globals": "^17.13.0",
    "pino-pretty": "^13.2.0",
    "supertest": "^7.3.1",
    "vitest": "^5.0.5"
  }
}
