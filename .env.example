NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Number of reverse proxies in front of the app (e.g. 1 on Heroku); 0 when serving TLS directly
TRUST_PROXY=0
DATABASE_URL=postgres://app_runtime:runtime@localhost:55432/app_dev
DATABASE_MIGRATION_URL=postgres://app_migrator:migrator@localhost:55432/app_dev
# >= 32 chars, generate with: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=
# NodeCrudEca consumer key/secret: filled by npm run init-env
SF_CANVAS_CONSUMER_KEY=
SF_CANVAS_CONSUMER_SECRET=
SF_MY_DOMAIN_URL=https://yourdomain.my.salesforce.com
SF_ALLOWED_ORG_ID=00D000000000000EAA
# Exact origins, space separated, no wildcards
SF_TRUSTED_ORIGINS=https://yourdomain.my.salesforce.com https://yourdomain.lightning.force.com https://yourdomain--c.vf.force.com
# Local HTTPS (mkcert)
TLS_CERT_FILE=certs/localhost.pem
TLS_KEY_FILE=certs/localhost-key.pem
