<%- include('../partials/head', { title }) %>
<h1>Customers</h1>
<form method="get" action="/customers">
  <input type="search" name="q" value="<%= q %>" placeholder="Name, email or document" maxlength="100">
  <button type="submit">Search</button>
  <a class="button" href="/customers/new">New customer</a>
</form>
<table>
  <thead><tr><th>Name</th><th>Document</th><th>Email</th><th>Phone</th><th></th></tr></thead>
  <tbody>
  <% customers.forEach((c) => { %>
    <tr>
      <td><a href="/customers/<%= c.id %>"><%= c.name %></a></td>
      <td><%= c.document %></td>
      <td><%= c.email || '' %></td>
      <td><%= c.phone || '' %></td>
      <td><a href="/customers/<%= c.id %>/edit">Edit</a></td>
    </tr>
  <% }) %>
  <% if (customers.length === 0) { %><tr><td colspan="5">No customers found.</td></tr><% } %>
  </tbody>
</table>
<p>
  <% if (page > 1) { %><a href="/customers?q=<%= encodeURIComponent(q) %>&page=<%= page - 1 %>">Previous</a><% } %>
  <% if (hasNext) { %><a href="/customers?q=<%= encodeURIComponent(q) %>&page=<%= page + 1 %>">Next</a><% } %>
</p>
<%- include('../partials/foot') %>
